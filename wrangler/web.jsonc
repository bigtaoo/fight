{
  // Static hosting (Cloudflare Workers static assets) for the web build of the game. Mirrors
  // D:\standing's wrangler/web.jsonc (same gamestao.com account).
  //
  // Build (outputs client/dist):   npm run build
  // Deploy (from the repo root):   npx wrangler deploy -c wrangler/web.jsonc
  //
  // Served at f.gamestao.com. routes[].custom_domain=true provisions the DNS record and edge
  // certificate on the first deploy.
  //
  // There is no backend online yet: on https the game cannot reach ws://<host>:5181, so it falls
  // back to playing offline (Game.connect). ?server=wss://... points it at one.
  "name": "dnf-web",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "../client/dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "f.gamestao.com", "custom_domain": true }
  ]
}
